# Enforce LF line endings across platforms so canonical byte digests and
# file manifests remain invariant across Windows and POSIX checkouts.
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
